NODE_ENV=development
PORT=4173
HOST=0.0.0.0

# Database driver: 'sqlite' (zero-config, for development) or 'postgres' (production).
# When using sqlite, no DATABASE_URL is needed — a file is created at ./data/medlens.db.
DB_DRIVER=sqlite

# Only needed when DB_DRIVER=postgres
DATABASE_URL=postgresql://medlens:replace_me@localhost:5432/medlens
# Set to 'true' for direct TLS connections. Leave 'false' when using Cloud SQL Auth Proxy.
DB_SSL=false

# In development mode, JWT_SECRET and DATA_ENCRYPTION_KEY are auto-generated
# if not set. For production, set both explicitly.
JWT_SECRET=replace-with-at-least-32-random-characters
# Exactly 32 random bytes, base64 encoded. Example: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

FRONTEND_ORIGIN=http://localhost:4173

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-this-password

